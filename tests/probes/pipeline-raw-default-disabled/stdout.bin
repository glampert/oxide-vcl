; flowMon::Emit() vcl 1.4beta7 produced this code:
		.vu
		.align 4
loop:
; _LNOPT_w=[ ] 5 [9 4] 5   [loop]
         mul           VF03,VF01,VF01                               NOP                                               
         mul           VF03,VF03,VF01                               isubiu        VI01,VI01,0x00000001                       ;	STALL_LATENCY ?3
         add           VF02,VF02,VF03                               NOP                                                      ;	STALL_LATENCY ?3
         NOP                                                        ibne          VI01,VI00,loop                      
         NOP                                                        NOP                                               
         NOP[E]                                                     NOP                                               
         NOP                                                        NOP                                               
		.align 4
;	iCount=7
; register stats:
;   2 VU User integer
;   3 VU User floating point
