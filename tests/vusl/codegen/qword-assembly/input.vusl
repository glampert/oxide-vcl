// Stores to the lanes of one qword become one SQ when their values can be
// made in one register's lanes: here a quotient, a constant and a
// negation.
struct Out { float s; float t; float q; float pad; };

struct In { vec4 v; };

void main(layout(address = 0) in In input,
          layout(address = 1) out Out result)
{
    result.s = -input.v.x;
    result.t = 2.0;
    result.q = 1.0 / input.v.w;
}
