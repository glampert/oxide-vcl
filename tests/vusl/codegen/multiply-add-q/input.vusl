// A product with a division's result reads Q in the chain: MULAQ, MADDAQ
// and MSUBAQ, then MADDQ or MSUBQ (quake2-ps2's textured_triangles.vcl:
// mulaw.xyz then maddq.xyz for the viewport).
struct In { vec4 a; vec4 b; vec4 c; };
struct Out { vec4 lerp; vec4 offset; vec4 sum; vec4 difference; vec4 mixed; };

void main(layout(address = 0) in In data,
          layout(address = 3) out Out result)
{
    float t = 1.0 / data.c.w;
    result.lerp = data.a + (data.b - data.a) * t;
    result.offset = data.c - data.a * t;
    result.sum = data.a * data.b + data.c * t;
    result.difference = data.a * data.b.x - data.c * t + data.b;
    result.mixed = data.a * data.b.y + data.b * t - data.c;
}
