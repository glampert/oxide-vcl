// A case with statements ends with break: it does not run into the next.
struct Block { layout(lane = x) int16 mode; layout(lane = y) int16 out0; vec4 v; };
void main(layout(address = 0) inout Block block)
{
    switch (block.mode)
    {
    case 1:
        block.out0 = 1;
    case 2:
        block.out0 = 2;
        break;
    }
}
