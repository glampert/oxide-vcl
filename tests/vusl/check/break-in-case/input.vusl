// A switch's break is its case's last statement; one inside it would end
// the case early, which an if and else write instead.
struct Block { layout(lane = x) int16 mode; layout(lane = y) int16 out0; vec4 v; };
void main(layout(address = 0) inout Block block)
{
    switch (block.mode)
    {
    case 1:
        if (block.out0 > 0)
            break;
        block.out0 = 1;
        break;
    }
}
