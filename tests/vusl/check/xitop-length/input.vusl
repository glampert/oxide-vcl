// An array length must be a constant, an earlier int16 member, or one of
// main's layout(xitop) parameters.
struct Item { vec4 value; };
struct Batch { Item items[total]; };

void main(layout(xitop) int16 count,
          layout(xtop, vif_base = 0, vif_offset = 400) inout Batch batch)
{
    for (inout Item item : batch.items)
        item.value = item.value * 2.0;
}
